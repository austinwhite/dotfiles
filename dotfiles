#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${HOME}"
IGNORE_FILE="$DOTFILES_DIR/.stow-local-ignore"
DRY_RUN=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [--dry-run] <command> [package]

Commands:
  deploy              Stow all non-ignored dotfile packages
  undeploy            Unstow all non-ignored dotfile packages
  redeploy            Unstow, then stow all non-ignored dotfile packages
  list                List managed packages and skipped packages
  ignored             List ignored packages
  ignore <package>    Add a package to .stow-local-ignore
  unignore <package>  Remove a package from .stow-local-ignore

EOF
}

all_packages() {
  find "$DOTFILES_DIR" -maxdepth 1 -mindepth 1 -type d \
    ! -name '.git' \
    ! -name '.*' \
    -exec basename {} \; | sort
}

package_exists() {
  [[ -d "$DOTFILES_DIR/$1" && "$1" != .* && "$1" != ".git" ]]
}

package_ignored() {
  local package="$1"
  local pattern

  [[ -r "$IGNORE_FILE" ]] || return 1

  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    pattern="${pattern%%#*}"
    pattern="${pattern//[[:space:]]/}"
    [[ -n "$pattern" ]] || continue
    [[ "$package" == "$pattern" ]] && return 0
  done < "$IGNORE_FILE"

  return 1
}

list_packages() {
  local package
  while IFS= read -r package; do
    if package_ignored "$package"; then
      echo "skip:   $package"
    else
      echo "manage: $package"
    fi
  done < <(all_packages)
}

list_ignored_packages() {
  local package
  while IFS= read -r package; do
    package_ignored "$package" && echo "$package"
  done < <(all_packages)
}

ignore_package() {
  local package="${1:-}"
  [[ -n "$package" ]] || { echo "Missing package name" >&2; exit 1; }
  package_exists "$package" || { echo "Unknown package: $package" >&2; exit 1; }

  touch "$IGNORE_FILE"

  if package_ignored "$package"; then
    echo "Already ignored: $package"
    return
  fi

  printf '%s\n' "$package" >> "$IGNORE_FILE"
  echo "Ignored: $package"
}

unignore_package() {
  local package="${1:-}"
  local tmp
  [[ -n "$package" ]] || { echo "Missing package name" >&2; exit 1; }

  [[ -f "$IGNORE_FILE" ]] || {
    echo "Not ignored: $package"
    return
  }

  if ! package_ignored "$package"; then
    echo "Not ignored: $package"
    return
  fi

  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    stripped="${line%%#*}"
    stripped="${stripped//[[:space:]]/}"
    [[ "$stripped" == "$package" ]] && continue
    printf '%s\n' "$line" >> "$tmp"
  done < "$IGNORE_FILE"

  mv "$tmp" "$IGNORE_FILE"
  echo "Unignored: $package"
}

run_stow() {
  local action="$1"
  local package
  local args=(--dir "$DOTFILES_DIR" --target "$TARGET_DIR")

  if [[ "$DRY_RUN" -eq 1 ]]; then
    args+=(--simulate --verbose)
  fi

  case "$action" in
    deploy) ;;
    undeploy) args+=(--delete) ;;
    *) echo "Unknown stow action: $action" >&2; exit 1 ;;
  esac

  while IFS= read -r package; do
    if package_ignored "$package"; then
      echo "skip: $package (.stow-local-ignore)"
      continue
    fi

    echo "${action}: $package"
    stow "${args[@]}" "$package"
  done < <(all_packages)
}

command=""
package_arg=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)
      DRY_RUN=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$command" ]]; then
        command="$1"
      elif [[ -z "$package_arg" ]]; then
        package_arg="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
        exit 1
      fi
      shift
      ;;
  esac
done

case "$command" in
  deploy)
    run_stow deploy
    ;;
  undeploy)
    run_stow undeploy
    ;;
  redeploy)
    run_stow undeploy
    run_stow deploy
    ;;
  list)
    list_packages
    ;;
  ignored)
    list_ignored_packages
    ;;
  ignore)
    ignore_package "$package_arg"
    ;;
  unignore)
    unignore_package "$package_arg"
    ;;
  '')
    usage
    exit 1
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage
    exit 1
    ;;
esac

echo "Done."
