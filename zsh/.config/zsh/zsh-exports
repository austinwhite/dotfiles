# General
export NVIMCONFIG="$XDG_CONFIG_HOME/nvim"

# Language/tool homes
export DENO_INSTALL="$HOME/.deno"
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
export NVM_DIR="$HOME/.nvm"

# Java / Android
[[ -d /opt/homebrew/opt/openjdk@17 ]] && export JAVA_HOME="/opt/homebrew/opt/openjdk@17"

# PATH helpers
path_prepend() {
  [[ -d "$1" ]] || return
  case ":$PATH:" in
    *":$1:"*) ;;
    *) export PATH="$1:$PATH" ;;
  esac
}

path_prepend "$HOME/miniconda3/bin"
path_prepend "/var/lib/snapd/snap/bin"
path_prepend "$DENO_INSTALL/bin"
path_prepend "/opt/android-studio/bin"
path_prepend "/opt/homebrew/bin"
path_prepend "/opt/homebrew/opt"
path_prepend "$PNPM_HOME/bin"

# nvm
if [[ -s /opt/homebrew/opt/nvm/nvm.sh ]]; then
  source /opt/homebrew/opt/nvm/nvm.sh
elif [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
fi

[[ -s /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm ]] && source /opt/homebrew/opt/nvm/etc/bash_completion.d/nvm

unfunction path_prepend
